include ../mixins/review
include ../data/index

-
    var REVIEWS = LANG.reviews;

    let array = [
        ...REVIEWS.reviews_beauty_age_skin,
        ...REVIEWS.reviews_beauty_age_skin_peeling,
        ...REVIEWS.reviews_delislim,
        ...REVIEWS.reviews_exurol,
        ...REVIEWS.reviews_desalix,
        ...REVIEWS.reviews_urosaf,
        ...REVIEWS.reviews_guavital,
        ...REVIEWS.reviews_demyxil,
        ...REVIEWS.reviews_vasaxal,
        ...REVIEWS.reviews_ausen,
        ...REVIEWS.reviews_paraxan,
        ...REVIEWS.reviews_steplex,
        ...REVIEWS.reviews_trovazin,
        ...REVIEWS.reviews_viarex,
        ...REVIEWS.reviews_vasos_duo
    ];

    if (['cz','hu','ro','be','gr'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_vermixin);
    };

    if (['cz','hr','sl'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_ultraxal);
    };

    if (['hu'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_remofix);
    };

    if (['ro','sk'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_ultiplex);
    };

    if (['bg','hr','pl','sl','sk'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_femixal);
    };

    if (['ee'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_cardiform);
    };

    if (['lt'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_oculax);
    };

    if (!['lt'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_ophtalax);
    };

    if (!['ee','lt','lv','pl','bg','it', 'sl'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_vermixin);
    };

    const perChunk = 2;

    const result = array.reduce((resultArray, item, index) => {
        const chunkIndex = Math.floor(index / perChunk)

        if (!resultArray[chunkIndex]) {
            resultArray[chunkIndex] = []
        }

        resultArray[chunkIndex].push(item)

        return resultArray
    }, []);



each reviews in result
    .reviews-list.swiper-slide
        each review in reviews
            +review(review)