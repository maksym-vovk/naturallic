include ../../mixins/product-page

-
	var PRODUCT_NAME = 'Cardiform'
	var PRODUCT_CARD = LANG.product_card;
	var CURRENT_PRODUCT = LANG.cardiform;
	var RECOMMENDATIONS = LANG.recommendations.filter(prod => prod.name === 'Beauty Age Skin' || prod.name === 'Beauty Age Skin Peeling' || prod.name === 'Demyxil')
	var REVIEWS = LANG.reviews.reviews_cardiform;
	REVIEWS.length = 3;

+productPage(PRODUCT_NAME, PRODUCT_CARD, CURRENT_PRODUCT, RECOMMENDATIONS, REVIEWS)