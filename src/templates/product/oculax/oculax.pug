include ../../mixins/product-page

-
    var PRODUCT_NAME = 'Oculax'
    var PRODUCT_CARD = LANG.product_card;
    var CURRENT_PRODUCT = LANG.oculax;
    var RECOMMENDATIONS = LANG.recommendations.filter(prod => prod.name === 'Paraxan' || prod.name === 'Steplex' || prod.name === 'Vasaxal')
    var REVIEWS = LANG.reviews.reviews_oculax;
    REVIEWS.length = 3;

+productPage(PRODUCT_NAME, PRODUCT_CARD, CURRENT_PRODUCT, RECOMMENDATIONS, REVIEWS)