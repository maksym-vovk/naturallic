include ../../mixins/product-page

-
	//- var isRender = LANG.locale !== 'ee' && LANG.locale !== 'lv' && LANG.locale !== 'lt'

	var PRODUCT_NAME = 'Ultraxal'
	var PRODUCT_CARD = LANG.product_card;
	var CURRENT_PRODUCT = LANG.ultraxal;
	var RECOMMENDATIONS = LANG.recommendations.filter(prod => prod.name === 'Vasaxal' || prod.name === 'GUAVITAL+' || prod.name === 'Exofeet Oil')
	var REVIEWS = LANG.reviews.reviews_ultraxal;
	REVIEWS.length = 3;

//- if isRender
+productPage(PRODUCT_NAME, PRODUCT_CARD, CURRENT_PRODUCT, RECOMMENDATIONS, REVIEWS)
