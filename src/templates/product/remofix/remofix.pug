include ../../mixins/product-page
include ../../mixins/product-review
include ../../mixins/product-short

-
	var PRODUCT_NAME = 'Remofix'
	var PRODUCT_CARD = LANG.product_card;
	var CURRENT_PRODUCT = LANG.remofix;
	var RECOMMENDATIONS = LANG.recommendations.filter(prod => prod.name === 'Deluron Forte' || prod.name === 'Paraxan' || prod.name === 'Desalix')
	var REVIEWS = LANG.reviews.reviews_remofix;
	REVIEWS.length = 3;

+productPage(PRODUCT_NAME, PRODUCT_CARD, CURRENT_PRODUCT, RECOMMENDATIONS, REVIEWS)