include ../../mixins/product-page

-
	var PRODUCT_NAME = 'Ultiplex'
	var PRODUCT_CARD = LANG.product_card;
	var CURRENT_PRODUCT = LANG.ultiplex;
	var RECOMMENDATIONS = LANG.recommendations.filter(prod => prod.name === 'Delislim' || prod.name === 'Paraxan' || prod.name === 'Steplex')
	var REVIEWS = LANG.reviews.reviews_ultiplex;
	REVIEWS.length = 3;

+productPage(PRODUCT_NAME, PRODUCT_CARD, CURRENT_PRODUCT, RECOMMENDATIONS, REVIEWS)
