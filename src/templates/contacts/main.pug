include ../data/lead-config
- var CONTACTS = LANG.contacts;

section.contacts
	.container
		h2.contacts__title.title!=CONTACTS.contacts_title
		.contacts__wrapper
			.contacts__form
				+leadForm('contacts-form js-lead-form', 'contacts')
					.contacts-form__success.js-success-form
						p.contacts-form__title!=CONTACTS.contacts_request_success_1
						p.contacts-form__desc!=CONTACTS.contacts_request_success_2
					.contacts-form__wrap.js-content-form
						p.contacts-form__title!=CONTACTS.contacts_form_title
						p.contacts-form__desc!=CONTACTS.contacts_form_description
						+leadHoneypot()
						.contacts-form__wrapper
							.contacts-form__inputs
								.lead-field
									input.contacts-form__input(type="text" name="name" placeholder=CONTACTS.contacts_field_name required aria-required="true" autocomplete="name")
									span.lead-field__error#contacts-name-error
								.lead-field
									input.contacts-form__input(type="tel" name="phone" inputmode="numeric" placeholder=CONTACTS.contacts_field_phone required aria-required="true" autocomplete="tel")
									span.lead-field__error#contacts-phone-error
								.lead-field
									input.contacts-form__input(type="email" name="email" placeholder=CONTACTS.contacts_field_email required aria-required="true" autocomplete="email")
									span.lead-field__error#contacts-email-error
								.lead-field
									textarea.contacts-form__input.contacts-form__input--text(name="message" placeholder=CONTACTS.contacts_field_message required aria-required="true")
									span.lead-field__error#contacts-message-error
							+leadCaptcha()
							+leadStatus()
							button.contacts-form__btn.btn(type="submit")!=CONTACTS.contacts_btn
