include ../mixins/review
include ../data/index

-
    var REVIEWS = LANG.reviews;

    let array = [
        ...REVIEWS.reviews_beauty_age_skin_peeling.splice(0,5),
        ...REVIEWS.reviews_beauty_age_skin.splice(0,5),
        ...REVIEWS.reviews_delislim.splice(0,5),
        ...REVIEWS.reviews_exurol.splice(0,5),
        ...REVIEWS.reviews_desalix.splice(0,5),
        ...REVIEWS.reviews_urosaf.splice(0,5),
        ...REVIEWS.reviews_guavital.splice(0,5),
        ...REVIEWS.reviews_demyxil.splice(0,5),
        ...REVIEWS.reviews_vasaxal.splice(0,5),
        ...REVIEWS.reviews_ausen.splice(0,5),
        ...REVIEWS.reviews_paraxan.splice(0,5),
        ...REVIEWS.reviews_steplex.splice(0,5),
        ...REVIEWS.reviews_trovazin.splice(0,5),
        ...REVIEWS.reviews_viarex.splice(0,5),
        ...REVIEWS.reviews_vasos_duo.splice(0,5)
    ];

    if (['cz','hr','sl'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_ultraxal.splice(0,5));
    };

    if (['hu'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_remofix.splice(0,5));
    };

    if (['ro','sk'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_ultiplex.splice(0,5));
    };

    if (['bg','hr','pl','sl','sk'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_femixal.splice(0,5));
    };

    if (['ee'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_kardivix.splice(0,5));
    };

    if (['lt'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_oculax.splice(0,5));
    };

    if (!['lt', 'ee'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_ophtalax.splice(0,5));
    };

    if (!['ee','lt','lv','pl','bg','it', 'sl', 'sk', 'hr'].includes(LANG.locale)) {
        array.push(...REVIEWS.reviews_vermixin.splice(0,5));
    };

    const perChunk = 2;

    const result = array.reduce((resultArray, item, index) => {
        const chunkIndex = Math.floor(index / perChunk)
        if (!resultArray[chunkIndex]) {
            resultArray[chunkIndex] = []
        }
        resultArray[chunkIndex].push(item)
        return resultArray
    }, []);



each reviews in result
    .reviews-list.swiper-slide
        each review in reviews
            +review(review)