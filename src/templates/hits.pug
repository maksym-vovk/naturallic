include mixins/product
include ./product-visibility.pug

- var HITS = LANG.hits.filter(isProductVisible)

.hits#js-scroll-hits.js-slider-products
    .hits__wrapper.swiper-wrapper
        each hit in HITS
            +product(hit)
    .hits__scrollbar.js-slider-hits-scrollbar.scrollbar